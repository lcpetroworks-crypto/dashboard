# Copie este arquivo para .env.local e preencha com os dados do Supabase
# (Project Settings -> API). Na Vercel, cadastre as mesmas variáveis em
# Settings -> Environment Variables.
VITE_SUPABASE_URL=https://<projeto>.supabase.co
VITE_SUPABASE_ANON_KEY=<chave anon public>
# opcional: endereço do gerencial, para o link "cadastrar o significado do prefixo" do Banco de Amostras
VITE_URL_GERENCIAL=http://localhost:5174

# serviço de gráficos padrão Origin (servico-graficos). Local: http://localhost:8010
VITE_URL_GRAFICOS=https://SEU-DOMINIO/graficos
